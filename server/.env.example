PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
AUTH_RATE_LIMIT=20

# TiDB Cloud / MySQL connection (used by scripts/create-db.js)
TIDB_HOST=your-gateway.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-user.root
TIDB_PASSWORD=your-password
TIDB_DATABASE=projectile_sim
TIDB_SSL=true

# Prisma connection string (same values as above)
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/projectile_sim?sslaccept=strict"
# Local SQLite alternative (change provider in prisma/schema.prisma to "sqlite"):
# DATABASE_URL="file:./dev.db"
